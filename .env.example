# Copy to .env and adjust. Never commit .env.
# The committed defaults run the whole stack locally at zero cost and with no signup.

# Application
APP_ENV=dev                  # dev | prod, controls structlog output format
LOG_LEVEL=INFO
API_KEY=                     # optional; when set, the HTTP API requires X-API-Key

# LLM provider
# ollama | anthropic | openai
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=2048

# Ollama (default: no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Anthropic (only when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI (only when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Per-node model overrides. Blank means "use the provider default above". Triage is a
# cheap classification, hypothesis forming is not, so they need not share a model.
LLM_MODEL_TRIAGE=
LLM_MODEL_GATHER_EVIDENCE=
LLM_MODEL_FORM_HYPOTHESIS=
LLM_MODEL_TEST_HYPOTHESIS=
LLM_MODEL_CONCLUDE=

# Investigation budgets. Both are hard limits: hitting one ends the investigation with
# an inconclusive diagnosis rather than looping.
MAX_ITERATIONS=5
MAX_TOOL_CALLS=20
TOOL_TIMEOUT_SECONDS=30

# The agent's own database
POSTGRES_DSN=postgresql+psycopg://dagdoctor:dagdoctor@localhost:5432/dag_doctor

# The analytics warehouse the broken pipelines read and write, also SELECT-only
WAREHOUSE_DSN=postgresql+psycopg://dagdoctor_ro:dagdoctor_ro@localhost:5432/warehouse

# Airflow's metadata database, read through a SELECT-only role
AIRFLOW_DSN=postgresql+psycopg://dagdoctor_ro:dagdoctor_ro@localhost:5432/airflow
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=airflow

# Redpanda (Kafka protocol)
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_CONSUMER_GROUP=dag-doctor-worker
KAFKA_TOPIC_FAILURES=airflow.task.failed
KAFKA_TOPIC_DIAGNOSES=agent.diagnosis.completed
KAFKA_TOPIC_DLQ=airflow.task.failed.dlq
